# ============================================================
#  ตัวอย่างไฟล์ตั้งค่า — คัดลอกไฟล์นี้เป็น ".env" แล้วใส่ค่าจริง
#  วิธีใช้: คัดลอกไฟล์นี้ ตั้งชื่อใหม่เป็น .env แล้วแก้ค่าด้านล่าง
#  ห้ามอัป .env ขึ้น GitHub เด็ดขาด! (.gitignore กันไว้ให้แล้ว)
# ============================================================

# Token ของบอทจาก Discord Developer Portal (บังคับ)
DISCORD_TOKEN=วาง_TOKEN_ของคุณ_ที่นี่

# Token ของกรมอุตุนิยมวิทยา (TMD) — ขอที่ https://data.tmd.go.th (ไม่บังคับ)
TMD_TOKEN=

# API key ของ SerpApi — ค้นผ่าน Google จริง สมัครฟรีที่ https://serpapi.com (ไม่บังคับ)
SERPAPI_KEY=

# API key ของ Google Gemini — https://aistudio.google.com/apikey (ไม่บังคับ ยังไม่ได้ใช้งานจริง)
GEMINI_API_KEY=

# ที่อยู่ Ollama API — ไม่ใส่ (เว้นว่าง) = ใช้ default http://localhost:11434/api/chat (ไม่บังคับ)
OLLAMA_URL=

# ชื่อโมเดล Ollama ที่จะใช้ — ไม่ใส่ (เว้นว่าง) = ใช้ default qwen3:8b (ไม่บังคับ)
#   qwen3:1.7b = เร็วสุด แต่โง่   |   qwen3:8b = สมดุล   |   qwen3:14b = ฉลาดขึ้นแต่ช้า (การ์ด 4GB ~1-2 นาที)
OLLAMA_MODEL=

# Discord user ID ของเจ้าของบอท — คนเดียวที่สั่งพิมพ์ PDF จริงได้ (คั่นด้วย , ถ้ามีหลายคน)
PRINT_ALLOWED_USER_IDS=111111111111111111

# เซิร์ฟเวอร์ (guild) ที่บอทจะตอบ — ไม่ใส่ (เว้นว่าง) = ตอบทุกเซิร์ฟเวอร์ที่ถูกเชิญเข้า (ไม่บังคับ)
# คั่นด้วย , ถ้ามีหลายเซิร์ฟเวอร์ — DM ไม่ถูกจำกัดด้วยค่านี้ (ใช้ DM_ALLOWED_USER_IDS ด้านล่างแทน)
ALLOWED_GUILD_IDS=

# คนที่ DM บอทได้ — ไม่ใส่ (เว้นว่าง) = เปิดรับ DM จากทุกคน (ไม่บังคับ) คั่นด้วย , ถ้ามีหลายคน
# แนะนำให้ตั้งถ้าบอทอยู่ใน server สาธารณะ (ALLOWED_GUILD_IDS ไม่คุม DM เลย)
DM_ALLOWED_USER_IDS=

# ชื่อเครื่องพิมพ์ (ต้องตรงกับใน Settings > Printers & scanners ของ Windows) — ไม่บังคับ
# ไม่ใส่ = ใช้ค่า default ในโค้ด (Canon E3300 series)
PRINTER_NAME=
